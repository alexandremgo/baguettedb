# Application
BAGUETTEDB_PORT=8080

# Postgres
POSTGRES_DB=baguettedb
POSTGRES_USER=baguettedb
POSTGRES_PASSWORD=dev
POSTGRES_PORT=5432

# Hydra
HYDRA_DB_USER=hydra
HYDRA_DB_PASSWORD=dev
HYDRA_PUBLIC_PORT=4444
HYDRA_ADMIN_PORT=4445
HYDRA_SECRETS_SYSTEM=a-very-insecure-secret-for-local-dev-only

# App-level config (for running locally outside Docker).
# Docker Compose constructs its own values using internal hostnames.

# Per-app database DSNs — each app gets its own database and user.
# Option 1: Set full DSNs directly (used by local dev / Docker Compose).
BAGUETTEDB_AUTH_DATABASE_DSN=postgres://baguette_auth:dev@localhost:5432/baguettedb_auth?sslmode=disable
BAGUETTEDB_BDBS_DATABASE_DSN=postgres://baguette_bdbs:dev@localhost:5432/baguettedb_bdbs?sslmode=disable
BAGUETTEDB_DATABASES_DATABASE_DSN=postgres://baguette_databases:dev@localhost:5432/baguettedb_databases?sslmode=disable
# Option 2: Set individual components (for an orchestrator that injects each secret as its own variable and can't
# interpolate them into a DSN).
# DSNs are built automatically when _DATABASE_DSN is empty but components are set.
# BAGUETTEDB_DB_HOST=postgres
# BAGUETTEDB_DB_PORT=5432
# BAGUETTEDB_AUTH_DB_NAME=baguettedb_auth
# BAGUETTEDB_AUTH_DB_USER=baguettedb_auth
# BAGUETTEDB_AUTH_DB_PASSWORD=secret
# BAGUETTEDB_BDBS_DB_NAME=baguettedb_bdbs
# BAGUETTEDB_BDBS_DB_USER=baguettedb_bdbs
# BAGUETTEDB_BDBS_DB_PASSWORD=secret
# BAGUETTEDB_DATABASES_DB_NAME=baguettedb_databases
# BAGUETTEDB_DATABASES_DB_USER=baguettedb_databases
# BAGUETTEDB_DATABASES_DB_PASSWORD=secret
# Option 3: Keep the records of all three apps in one SQLite file instead of Postgres (single-machine
# installs). When set, the DSNs above are ignored.
# BAGUETTEDB_INSTANCE_SQLITE_PATH=./local-data/instance.sqlite
BAGUETTEDB_HYDRA_PUBLIC_URL=http://localhost:4444
BAGUETTEDB_HYDRA_ADMIN_URL=http://localhost:4445
# Public URL for OAuth discovery (used in /.well-known responses).
# Defaults to http://localhost:<BAGUETTEDB_PORT> if not set.
BAGUETTEDB_PUBLIC_URL=http://localhost:8080
# Dev compose only: overrides the public origin for the OAuth issuer and the login/consent redirects, e.g. an
# HTTPS tunnel URL to complete a login from another device. Set BAGUETTEDB_APP_BASE_URL to the same origin when the
# web frontend is reached through it too.
# BAGUETTEDB_DEV_ORIGIN=https://my-tunnel.example.com

# Bdbs service URL (used by databases service and MCP gateway in standalone/microservice mode).
# Defaults to http://localhost:8001 if not set.
BAGUETTEDB_BDBS_URL=http://localhost:8001

# Databases service URL (used by MCP gateway in standalone/microservice mode).
# Defaults to http://localhost:8002 if not set.
BAGUETTEDB_DATABASES_URL=http://localhost:8002

# Admin Bootstrap
# On first startup (empty users table), a single admin account is created with these credentials.
# Change the password after first login. No-op on subsequent startups.
BAGUETTEDB_ADMIN_EMAIL=admin@example.com
BAGUETTEDB_ADMIN_PASSWORD=CHANGE-ME-STRONG-PASSWORD

# Quota limits. Unset or 0 disables a cap; the caps below (bdbs per user, size per database, members per bdb) have
# no built-in default, so a stack that sets nothing runs unlimited. The values here are small caps to try them out.
BAGUETTEDB_QUOTA_MAX_BDBS=5
BAGUETTEDB_QUOTA_MAX_DB_SIZE_BYTES=10485760
# Maximum total size in bytes across all databases owned by one user, enforced on size-growing
# writes and database creation. 0 disables the aggregate cap (only the per-database cap applies).
BAGUETTEDB_QUOTA_MAX_TOTAL_DB_SIZE_BYTES=0
BAGUETTEDB_QUOTA_MAX_MEMBERS_PER_BDB=5
# Maximum undo stack entries per database.
BAGUETTEDB_QUOTA_UNDO_STACK_MAX_SIZE=50
# Maximum affected rows returned in a mutation response.
BAGUETTEDB_QUOTA_AFFECTED_ROWS_MAX=100
# Maximum SQL statements in one write request (execute_data, execute_schema). Unset or 0 means the default, 100.
BAGUETTEDB_QUOTA_MAX_STATEMENTS_PER_REQUEST=100
# Maximum rows the statements of one write request may change in total. Unset or 0 means the default, 1000.
BAGUETTEDB_QUOTA_MAX_ROWS_PER_REQUEST=1000
# Maximum rows one read request (execute_query, formula runs) may return; larger results are refused
# with a hint to add a LIMIT, aggregate, paginate, or export. Unset or 0 means the default, 1000.
BAGUETTEDB_QUOTA_MAX_QUERY_RESULT_ROWS=1000
# Maximum SQL requests (queries, writes, schema changes, formula runs) one user may have in flight at
# the same time in one process; one more is refused with a retry hint. Unset or 0 means the default, 4.
BAGUETTEDB_QUOTA_MAX_CONCURRENT_QUERIES=4
# Maximum rows captured per destructive-DDL pre-image snapshot (DROP COLUMN
# values, DROP TABLE rows). Beyond this cap the snapshot is marked truncated
# and undo restores only the captured rows.
BAGUETTEDB_QUOTA_SNAPSHOT_MAX_ROWS=10000
# Maximum successful full-database exports per database and per user within
# BAGUETTEDB_QUOTA_DB_EXPORT_WINDOW (failed or aborted downloads don't count).
BAGUETTEDB_QUOTA_MAX_DB_EXPORTS_PER_WINDOW=1
# Rolling window over which successful full-database exports are counted.
BAGUETTEDB_QUOTA_DB_EXPORT_WINDOW=24h
# Maximum rows a formula CSV export may return; larger results are rejected.
BAGUETTEDB_QUOTA_MAX_FORMULA_EXPORT_ROWS=100000

# Time budget for one SQL request (classification plus execution, including time spent waiting for the
# bdb's connection); exceeding it returns 504. The same value caps every individual statement the
# databases service runs, so background callers that pass context.Background() stay bounded too.
# Defaults to 30s.
BAGUETTEDB_DATABASES_MAX_QUERY_DURATION=30s

# Per-run timeout for running a formula from the app, separate from (and
# typically shorter than) the general query ceiling above: app runs should feel
# snappy, and exceeding this returns a distinct "too big to run in the app"
# error so the UI can point the user at their AI assistant. Defaults to 5s.
BAGUETTEDB_DATABASES_FORMULA_RUN_TIMEOUT=5s

# How often the bdbs service sweeps for soft-deleted bdbs whose 7-day
# grace period has expired and hard-deletes them. Shorten for local dev to see
# the purge fire quickly; extend for ops tuning. Does NOT change the user-facing
# grace-period duration (locked at 7 days). Defaults to 1h.
BAGUETTEDB_BDBS_PURGE_INTERVAL=1h

# Caps the total bytes of skill bodies inlined in one describe_bdb MCP response. At or under the cap
# every skill body (bdb-level and table-targeted) is inlined; over it, table-targeted bodies degrade
# to summaries and the response's `omitted` note points agents at describe_table / get_skill.
# Defaults to 16384 (16 KiB).
BAGUETTEDB_MCP_DESCRIBE_BDB_SKILL_BODY_BUDGET_BYTES=16384

# Caps how many tables a bdb may have before describe_bdb stops inlining column-level schemas. At or
# under the limit every table entry carries its columns and foreign keys; over it, all entries degrade
# to name+type and the response's `omitted` note points agents at describe_table. Defaults to 20.
BAGUETTEDB_MCP_DESCRIBE_BDB_SCHEMA_TABLE_LIMIT=20

# How long each HTTP server is given to drain in-flight requests after a SIGINT/SIGTERM before the process exits.
# Should not exceed the grace period your process manager allows before killing the process. Defaults to 30s.
BAGUETTEDB_SHUTDOWN_TIMEOUT=30s

# How long the MCP gateway retries connecting to each backend MCP server (bdbs, databases) at startup before
# giving up — so a briefly-unreachable backend (a rolling restart or a blue/green cutover) doesn't crash-loop the
# gateway. Defaults to 60s.
BAGUETTEDB_MCP_GATEWAY_BACKEND_INIT_TIMEOUT=60s

# On-disk directory holding per-bdb SQLCipher database files. Required —
# the databases service refuses to start if unset. Each bdb gets one
# encrypted SQLite file at <data_dir>/<database_uuid>.db.
BAGUETTEDB_DATABASES_DATA_DIR=/var/lib/baguettedb/databases

# Path to a file containing the 32-byte raw KEK (key-encryption key) used to
# wrap each bdb's per-database DEK. Required. Never set the key itself as an
# env var — only the file path is passed through env.
# Local dev: generated on the first start (see the flag below).
# Deployed envs: mounted from your secret manager.
BAGUETTEDB_DATABASES_KEK_FILE=/var/lib/baguettedb/kek
# Generates the KEK at BAGUETTEDB_DATABASES_KEK_FILE on startup when the file is
# absent. Off by default so a deployment that forgot to mount its key fails
# loudly instead of silently minting one nobody backed up. Back the generated
# file up: without it every bdb file is unreadable.
# BAGUETTEDB_DATABASES_KEK_AUTOGENERATE=true

# Idle TTL for cached SQLCipher connectors. A connector is closed after this
# much idle time. Defaults to 30m.
BAGUETTEDB_DATABASES_SQLITE_CACHE_TTL=30m

# Hard cap on the number of simultaneously open SQLCipher connectors. LRU
# eviction kicks in above this entry count. Defaults to 500.
BAGUETTEDB_DATABASES_SQLITE_CACHE_MAX_ENTRIES=500

# How long a statement on a bdb file waits for a lock another connection or process holds before failing, e.g. when
# several processes share one data directory. Defaults to 5s.
BAGUETTEDB_DATABASES_SQLITE_BUSY_TIMEOUT=5s

# S3-compatible object storage for database snapshots (optional — leave the
# endpoint empty to keep backup features disabled).
# The bucket must already exist; it is provisioned by the deployment, never
# created by the application.
# BAGUETTEDB_DATABASES_S3_ENDPOINT=https://s3.example.com
# S3 region. Defaults to "gra" if not set.
# BAGUETTEDB_DATABASES_S3_REGION=gra
# BAGUETTEDB_DATABASES_S3_BUCKET=
# BAGUETTEDB_DATABASES_S3_PREFIX=
# BAGUETTEDB_DATABASES_S3_ACCESS_KEY_ID=
# BAGUETTEDB_DATABASES_S3_SECRET_ACCESS_KEY=
# Path-style addressing (endpoint/bucket/key)
# BAGUETTEDB_DATABASES_S3_USE_PATH_STYLE=false

# How often the backup runner sweeps for databases changed since their last snapshot (the backup RPO). Defaults to 15m.
# BAGUETTEDB_DATABASES_BACKUP_INTERVAL=15m

# Kill switch for the periodic backup runner (the internal on-demand snapshot endpoints stay available).
# Set to false during a force deploy when the snapshot path itself blocks a rollout. Defaults to true.
# BAGUETTEDB_DATABASES_BACKUP_ENABLED=true

# Freshness floor: an unchanged database is still re-snapshotted when its newest stored snapshot is older than this.
# Keep well under the bucket's lifecycle expiry (7 days) so idle databases always keep one live snapshot.
# Defaults to 84h.
# BAGUETTEDB_DATABASES_BACKUP_MAX_SNAPSHOT_AGE=84h

# Boot reconcile pass (restores missing database files from their latest snapshots):
# strict = fail startup when a restore fails (default); warn = log loudly and start anyway —
# the force-deploy escape hatch when the snapshot store itself is down.
# BAGUETTEDB_DATABASES_RECONCILE_MODE=strict

# Sharding (several databases instances). Defaults keep single-instance behavior: shard count 1 disables routing
# entirely and every request is served locally.
# - SHARD_COUNT: number of databases instances bdbs are sharded across.
# - POD_NAME: this instance's name; the shard ordinal is parsed from its suffix, e.g. db-2 -> 2. Empty means
#   ordinal 0 and no shard routing.
# - PEER_URL_TEMPLATE: builds a peer instance's base URL from its {color} (blue/green) and {ordinal} tokens.
#   Required, with both tokens, whenever POD_NAME is set.
# - POD_COLOR: this instance's blue/green fleet (0=blue, 1=green), set per fleet for low-downtime deploys.
#   0 in single-fleet/monolith deployments. With the shard ordinal it identifies which databases this instance owns.
# BAGUETTEDB_DATABASES_SHARD_COUNT=1
# BAGUETTEDB_DATABASES_POD_NAME=
# BAGUETTEDB_DATABASES_PEER_URL_TEMPLATE=http://db-{color}-{ordinal}.example.internal:8002
# BAGUETTEDB_DATABASES_POD_COLOR=0

# OAuth2 client ID for the web SPA (used by the BFF cookie token handler for refresh requests).
# Optional: leave empty and the auth module provisions a first-party client named
# baguettedb-web in Hydra at startup, with <BAGUETTEDB_APP_BASE_URL>/callback as redirect URI.
BAGUETTEDB_WEB_CLIENT_ID=

# Extra sources for the embedded web frontend's Content-Security-Policy, space-separated, appended to script-src,
# connect-src and img-src respectively. By default each directive allows the app's own origin ('self'); img-src
# also allows data: URIs, and connect-src also https: plus the http://localhost:* and http://127.0.0.1:* origins.
# BAGUETTEDB_WEBUI_CSP_SCRIPT_SRC_EXTRA=
# BAGUETTEDB_WEBUI_CSP_CONNECT_SRC_EXTRA=
# BAGUETTEDB_WEBUI_CSP_IMG_SRC_EXTRA=

# Secure flag on httpOnly auth cookies. When unset it follows the BAGUETTEDB_PUBLIC_URL
# scheme (https → true, http → false); set it explicitly to override.
# BAGUETTEDB_SECURE_COOKIES=false

# Public base URL of the web frontend (used to build invite links).
# Defaults to http://localhost:5173 if not set.
BAGUETTEDB_APP_BASE_URL=http://localhost:5173

# Maximum HTTP request body size in bytes.
BAGUETTEDB_MAX_REQUEST_BODY_SIZE=1048576

# Shared secret for internal service-to-service endpoints (/internal/*), sent in the
# X-Internal-Api-Secret header. Required by the split-service binaries (the monolith
# does not expose internal endpoints). Generate with: openssl rand -hex 32
# BAGUETTEDB_INTERNAL_API_SECRET=

# OpenTelemetry (optional — disabled by default)
# Local dev with Tempo: BAGUETTEDB_OTEL_ENDPOINT=localhost:4317, BAGUETTEDB_OTEL_INSECURE=true
# A hosted OTLP endpoint: BAGUETTEDB_OTEL_ENDPOINT=otlp.example.com:443,
#   BAGUETTEDB_OTEL_HEADERS=Authorization=Basic <base64>
# BAGUETTEDB_OTEL_ENABLED=true
# BAGUETTEDB_OTEL_ENDPOINT=localhost:4317
# BAGUETTEDB_OTEL_INSECURE=true
# BAGUETTEDB_OTEL_ENVIRONMENT=dev
